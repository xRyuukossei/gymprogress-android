<?xml version="1.0" encoding="utf-8"?>
<!-- Backup e transferência entre aparelhos (Android 12+). O token fica de fora:
     ele é criptografado com uma chave do Keystore que não é restaurada. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="gymprogress_secure.xml" />
        <exclude domain="sharedpref" path="gymprogress_timer.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="gymprogress_secure.xml" />
        <exclude domain="sharedpref" path="gymprogress_timer.xml" />
    </device-transfer>
</data-extraction-rules>
